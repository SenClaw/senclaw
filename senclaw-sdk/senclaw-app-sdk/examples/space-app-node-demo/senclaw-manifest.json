{
  "id": "node-demo",
  "name": "Node Demo",
  "description": "Space App tối giản viết bằng Node: 2 MCP tool, một trang UI, chạy theo phiên.",
  "icon": "🟩",
  "runtime": {
    "kind": "server",
    "mode": "session",
    "runner": "node",
    "start": "node server.mjs",
    "install": "npm install --omit=dev",
    "healthPath": "/api/status",
    "port": 4820,
    "idleTimeoutSecs": 60
  },
  "requires": {
    "node": ">=18"
  },
  "sandbox": {
    "enabled": true,
    "readMode": "open",
    "network": "all",
    "daemonApi": true
  },
  "integration": { "type": "iframe", "url": "/" },
  "bridge": {
    "postMessage": true,
    "capabilities": ["space.rest", "llm.request"]
  },
  "mcp": {
    "name": "node-demo-mcp",
    "transport": "http",
    "path": "/api/mcp/sse",
    "description": "Demo tools written in Node",
    "autoRegister": true
  }
}
